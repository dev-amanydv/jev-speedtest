# ==============================================================================
# JEV SPEED TEST - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate with your API keys:
#   cp .env.example .env.local
#
# NOTE: If keys are left blank or with placeholder values, the application
# automatically operates in high-fidelity realistic benchmark simulation mode.

# ------------------------------------------------------------------------------
# 1. JEV CONFIGURATION
# ------------------------------------------------------------------------------
# Jev is evaluated via Vercel AI Gateway (typesafe-ai/jev).
# Obtain key from: Vercel Dashboard -> AI Gateway or your Jev account
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here

# Alternatively, you can set JEV_API_KEY directly:
# JEV_API_KEY=your_jev_api_key_here

# ------------------------------------------------------------------------------
# 2. TRADITIONAL LLM CONFIGURATION (GEMINI + GROQ FALLBACK)
# ------------------------------------------------------------------------------
# Primary Provider: Google Gemini API Key
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-3.5-flash-lite)
# Other options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback Provider: Groq Cloud API Key
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (default: openai/gpt-oss-120b)
# Other options: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. RATE LIMITING & ABUSE PROTECTION
# ------------------------------------------------------------------------------
# Maximum benchmark runs allowed per window per IP (default: 5)
RATE_LIMIT_MAX_REQUESTS=5

# Rate limit window duration in seconds (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum concurrent benchmark requests per IP per route (default: 1)
RATE_LIMIT_MAX_CONCURRENT=1

# Maximum concurrent benchmark requests server-wide per route (default: 5)
RATE_LIMIT_GLOBAL_MAX_CONCURRENT=5

